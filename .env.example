# Shopify Storefront API — the shop's own domain, not the custom one
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (Shopify admin → Settings → Apps → Develop apps →
# your app → API credentials → Storefront API access token). Read-only by nature:
# it may read products and write carts, and nothing else.
SHOPIFY_STOREFRONT_TOKEN=

# Optional. Pins which market's prices and currency are shown. Defaults to DE.
SHOPIFY_DEFAULT_COUNTRY=DE

# Optional. Pins the Storefront API version; defaults to 2026-01.
# SHOPIFY_API_VERSION=2026-01

# The product shown on the landing page, by its Shopify handle.
NEXT_PUBLIC_PRODUCT_HANDLE=

# Admin API access token (shpat_...) for scripts/shopify only — never used by the app.
# Create it under Settings -> Apps and sales channels -> Develop apps; scopes are listed in
# scripts/shopify/README.md. Leave empty unless you are provisioning the store.
SHOPIFY_ADMIN_TOKEN=
